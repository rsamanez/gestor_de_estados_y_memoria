# Variables de entorno requeridas
# Copia este archivo a .env.local y completa con tus valores reales

# AWS Configuration - Requerido para subir archivos a S3
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here  
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name_here

# Node Environment
NODE_ENV=development

# API Configuration
API_PORT=3001
FRONTEND_URL=http://localhost:5173

# Redis Configuration (copia el valor de Vercel)
REDIS_URL="redis://default:your_password@your_redis_url:your_port"

# Instrucciones:
# 1. Copia este archivo: cp .env.example .env.local
# 2. Configura tus credenciales AWS reales
# 3. Crea un bucket S3 y actualiza S3_BUCKET_NAME
# 4. Ejecuta: npm run test-server